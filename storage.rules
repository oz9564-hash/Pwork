rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 같은 카테고리(팀) 멤버가 공유하는 PDF·이미지·폰트 파일.
    // 본인 프로필의 category가 경로의 category와 같을 때만 허용.
    match /categories/{category}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.category == category;
    }

    // 기존 사용자별 파일(마이그레이션 원본 백업). 본인만 접근.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
