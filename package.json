{
  "name": "pdf-text-mapper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-poc/runtime/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "bun run build && firebase deploy"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "cfb": "^1.2.2",
    "firebase": "^12.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pako": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "firebase-admin": "^14.1.0",
    "typescript": "^5.7.2",
    "wait-on": "^9.1.0"
  }
}
